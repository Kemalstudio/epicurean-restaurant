# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM="Epicurean" <no-reply@your-domain.com>

# Admin account (created at server start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Server
PORT=5000
HOST=0.0.0.0
# Comma-separated list of allowed frontend origins (leave empty in development)
CORS_ORIGIN=
NODE_ENV=development

# Database file (SQLite). Default: backend/data/epicurean.db
DB_PATH=

# Pricing (in TMT)
DELIVERY_FEE=4.99
FREE_DELIVERY_FROM=50
TAX_RATE=0.08

# Public address of the website (used in password reset emails), e.g. https://ember.tm
FRONTEND_URL=
# Time zone used for "open now" (restaurant hours)
TIME_ZONE=Asia/Ashgabat
