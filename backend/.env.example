# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM="Epicurean" <no-reply@your-domain.com>

# Admin account (created at server start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Server
PORT=5000
HOST=0.0.0.0
# Comma-separated list of allowed frontend origins (leave empty in development)
CORS_ORIGIN=
NODE_ENV=development
